NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bedallocation_rebuild
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=4h
CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
# Set COOKIE_SECURE=true behind HTTPS. Required when COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
PLATFORM_ADMIN_NAME=BedAllocation Platform Administrator
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_password_at_least_14_chars
# Required before production contact-form submissions are enabled.
TURNSTILE_SECRET_KEY=
CONTACT_EMAIL=hello@example.com

# In-app reminders apply only to ICU waiting-list patients. Defaults: 8-minute cadence, 60-second poll.
ICU_REMINDER_INTERVAL_MINUTES=8
ICU_REMINDER_POLL_INTERVAL_MS=15000

# Private research ML metadata proxy; key must match ml-service/.ml-api-key.local
BEDALLOCATION_ML_SERVICE_URL=http://127.0.0.1:8001
BEDALLOCATION_ML_API_KEY=replace_with_the_same_private_key_used_by_the_python_service
# Optional second local process for side-by-side synthetic research demos only.
# When configured, the second process should serve xgboost_hist_weighted on port 8002.
BEDALLOCATION_XGBOOST_SERVICE_URL=
# Optional; if blank, the backend uses BEDALLOCATION_ML_API_KEY for this second service.
BEDALLOCATION_XGBOOST_API_KEY=
